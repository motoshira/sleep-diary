{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleep-diary",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // ビルド成果物に一致しないパスは index.html を返す（SPA のため）
    "not_found_handling": "single-page-application",
    // アセットも Worker を通す。そうしないと Basic 認証より先に配信されてしまう
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sleep-diary",
      "database_id": "163c9102-671f-4503-be8e-bef925ed830e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    // プレビュー環境。`wrangler deploy --env preview` で sleep-diary-preview にデプロイされる
    "preview": {
      "name": "sleep-diary-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sleep-diary-preview",
          "database_id": "7b1c85ab-fc5c-4600-b120-3f5b7cee5f60",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
