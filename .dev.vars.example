# ローカル開発用。.dev.vars にコピーして値を入れる（.dev.vars は commit しない）

# サイト全体にかける Basic 認証。未設定だと Worker が 503 を返す
BASIC_AUTH_USER="xxxxxxxx"
BASIC_AUTH_PASSWORD="xxxxxxxx"

GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"
# openssl rand -base64 32 などで生成する
SESSION_SECRET="xxxxxxxx"
